{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "enabledManagers": [
    "argocd",
    "custom.regex"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^templates\\/(apps|operators|istio)\\/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker image Pins inside botato valuesObject (file is a Helm template, so helm-values cannot parse it)",
      "managerFilePatterns": ["/^templates\\/apps\\/botato\\.yaml$/"],
      "matchStrings": [
        "repository:\\s+(?<depName>\\S+)\\s+tag:\\s+[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Lavalink YouTube plugin Pin inside botato application.yml",
      "managerFilePatterns": ["/^templates\\/apps\\/botato\\.yaml$/"],
      "matchStrings": [
        "dependency:\\s*\"dev\\.lavalink\\.youtube:youtube-plugin:(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "dev.lavalink.youtube:youtube-plugin",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.lavalink.dev/releases"
    },
    {
      "customType": "regex",
      "description": "Inbox Zero app image Pin inside valuesObject (Helm template)",
      "managerFilePatterns": ["/^templates\\/apps\\/inbox-zero\\.yaml$/"],
      "matchStrings": [
        "repository:\\s+ghcr\\.io/elie222/inbox-zero\\s+tag:\\s+[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "ghcr.io/elie222/inbox-zero",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Inbox Zero chart git SHA Pin (path charts/inbox-zero)",
      "managerFilePatterns": ["/^templates\\/apps\\/inbox-zero\\.yaml$/"],
      "matchStrings": [
        "repoURL: https://github\\.com/elie222/inbox-zero\\n\\s+targetRevision: (?<currentValue>[a-f0-9]{40})"
      ],
      "matchStringsStrategy": "recursive",
      "depNameTemplate": "https://github.com/elie222/inbox-zero",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Floats stay unmanaged",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^(latest|preview)$/",
      "enabled": false
    },
    {
      "description": "Default: propose-only (platform charts, companions, majors)",
      "matchManagers": ["argocd", "custom.regex"],
      "automerge": false
    },
    {
      "description": "Botato bot image: automerge patch and minor Pins",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/adryan30/botato"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Longhorn requires one minor upgrade at a time; Renovate patches only",
      "matchManagers": ["argocd"],
      "matchPackageNames": ["longhorn"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    }
  ]
}
